+}
+
+.wa-empty {
+  padding: 40px 20px;
+  text-align: center;
+  color: var(--wa-text-soft);
+  font-size: 14px;
+}
+
+/* ─── Messages thread ─────────────────────────────────────── */
+
+.wa-messages {
+  flex: 1;
+  overflow-y: auto;
+  padding: 12px 10px;
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+  -webkit-overflow-scrolling: touch;
+  background-image: radial-gradient(rgba(0,0,0,0.03) 1px, transparent 1px);
+  background-size: 16px 16px;
+}
+
+.wa-bubble-row { display: flex; }
+.wa-bubble-row.out { justify-content: flex-end; }
+
+.wa-bubble {
+  max-width: 78%;
+  padding: 7px 10px 6px;
+  border-radius: 8px;
+  box-shadow: 0 1px 0.5px rgba(0,0,0,0.13);
+  position: relative;
+}
+.wa-bubble-row.in .wa-bubble { background: var(--wa-bubble-in); border-top-left-radius: 2px; }
+.wa-bubble-row.out .wa-bubble { background: var(--wa-bubble-out); border-top-right-radius: 2px; }
+
+.wa-bubble-text { font-size: 14.5px; line-height: 1.4; white-space: pre-wrap; word-break: break-word; }
+.wa-bubble-time { font-size: 10.5px; color: var(--wa-text-soft); text-align: right; margin-top: 3px; }
+
+.wa-bubble-translate-btn {
+  border: none;
+  background: none;
+  font-size: 12px;
+  color: var(--wa-green-dark);
+  padding: 0;
+  margin-top: 4px;
+  cursor: pointer;
+  opacity: 0.75;
+}
+.wa-bubble-translation {
+  margin-top: 6px;
+  padding-top: 6px;
+  border-top: 1px dashed rgba(0,0,0,0.12);
+  font-size: 13.5px;
+  font-style: italic;
+  color: #3a4a4a;
+}
+.wa-bubble-translation .wa-tr-label { font-style: normal; font-size: 10.5px; color: var(--wa-text-soft); display: block; margin-bottom: 2px; }
+
+.wa-lang-chips {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 6px;
+  margin-top: 6px;
+}
+.wa-lang-chip {
+  border: 1px solid var(--wa-line);
+  background: #fff;
+  border-radius: 12px;
+  padding: 3px 9px;
+  font-size: 11.5px;
+  cursor: pointer;
+  color: var(--wa-text);
+}
+.wa-lang-chip:active { background: var(--wa-line); }
+
+/* ─── Translation preview strip ──────────────────────────── */
+
+.wa-translate-strip {
+  flex: none;
+  background: #FFF3CD;
+  color: #664d03;
+  font-size: 12px;
+  padding: 8px 12px;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 10px;
+}
+.wa-translate-strip span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+#translate-strip-original { font-style: italic; }
+.wa-translate-strip button {
+  flex: none;
+  border: none;
+  background: #664d03;
+  color: #fff;
+  font-size: 11px;
+  font-weight: 600;
+  padding: 4px 10px;
+  border-radius: 12px;
+  cursor: pointer;
+}
+
+/* ─── Compose bar ─────────────────────────────────────────── */
+
+.wa-compose {
+  flex: none;
+  display: flex;
+  align-items: flex-end;
+  gap: 8px;
+  padding: 8px 10px calc(env(safe-area-inset-bottom, 0px) + 8px);
+  background: #F0F0F0;
+  border-top: 1px solid var(--wa-line);
+}
+
+.wa-lang-select {
+  flex: none;
+  height: 40px;
+  border: 1px solid var(--wa-line);
+  border-radius: 20px;
+  background: #fff;
+  font-size: 12px;
+  padding: 0 6px;
+  max-width: 70px;
+}
+
+#compose-input {
+  flex: 1;
+  resize: none;
+  border: none;
+  border-radius: 20px;
+  padding: 10px 14px;
+  font-size: 14.5px;
+  font-family: inherit;
+  background: #fff;
+  max-height: 100px;
+  outline: none;
+}
+
+.wa-translate-btn {
+  color: var(--wa-green-dark);
+  background: #fff;
+  border: 1px solid var(--wa-line);
+  border-radius: 50%;
+  font-size: 18px;
+}
+
+.wa-send-btn {
+  flex: none;
+  width: 40px;
+  height: 40px;
+  border-radius: 50%;
+  border: none;
+  background: var(--wa-green);
+  color: #fff;
+  font-size: 17px;
+  cursor: pointer;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+}
+.wa-send-btn:disabled { opacity: 0.5; }
+
+/* ─── Small screens: keep everything within a real mobile viewport ─── */
+@media (min-width: 560px) {
+  body { display: flex; justify-content: center; background: #111; }
+  .wa-screen { max-width: 480px; width: 100%; box-shadow: 0 0 30px rgba(0,0,0,0.3); }
+}
