+// Builds the unified list of earning records across every client, picking
+// the record source per-client based on BulkBilling — see block comment
+// above. Each record: { source, id, clientId, clientName, amount, date,
+// status, notes }.
+function getUnifiedEarningsRecords() {
+  const bulkClientIds = new Set(
+    allClients.filter(c => c.BulkBilling).map(c => String(c.UniqueID))
+  );
+
+  const paymentRecords = allPayments
+    .filter(p => bulkClientIds.has(String(p.ClientID)))
+    .map(p => ({
+      source: 'payment',
+      id: p.PaymentID,
+      clientId: p.ClientID,
+      clientName: p.ClientName || clientName(p.ClientID),
+      amount: Number(p.Amount) || 0,
+      date: p.Date,
+      status: p.Status || 'Pending',
+      notes: p.Notes || '',
+    }));
+
+  const taskRecords = allTasks
+    .filter(t => !bulkClientIds.has(String(t.ClientID)))
+    .map(t => ({
+      source: 'task',
+      id: t.TaskID,
+      clientId: t.ClientID,
+      clientName: t.ClientName || clientName(t.ClientID),
+      amount: Number(t.Amount) || 0,
+      // Tasks don't have a "paid on" date the way payments do — the due
+      // date is the closest proxy, falling back to when the task was
+      // created if no due date was set.
+      date: t.DueDate || t.CreatedAt,
+      status: t.PaymentStatus || 'Pending',
+      notes: t.Description || '',
+    }));
+
+  return [...paymentRecords, ...taskRecords];
+}
