+/* whatsapp-mobile.css — standalone mobile-app-style chat UI, meant to be
+   loaded inside a webview wrapper app (see server.js: GET /whatsapp.html). */
+
+:root {
+  --wa-green-dark: #075E54;
+  --wa-green: #128C7E;
+  --wa-green-light: #25D366;
+  --wa-bg: #ECE5DD;
+  --wa-bubble-out: #DCF8C6;
+  --wa-bubble-in: #FFFFFF;
+  --wa-text: #111B21;
+  --wa-text-soft: #667781;
+  --wa-line: #E9EDEF;
+  --wa-danger: #DC2626;
+}
+
+* { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
+
+html, body {
+  margin: 0;
+  padding: 0;
+  height: 100%;
+  overflow: hidden;
+  background: var(--wa-bg);
+  color: var(--wa-text);
+  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, system-ui, sans-serif;
+  font-size: 15px;
+}
+
+.wa-screen {
+  position: fixed;
+  inset: 0;
+  display: flex;
+  flex-direction: column;
+  height: 100dvh;
+  background: var(--wa-bg);
+}
+.wa-hidden { display: none !important; }
+
+/* ─── Top bar ─────────────────────────────────────────────── */
+
+.wa-topbar {
+  flex: none;
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  padding: calc(env(safe-area-inset-top, 0px) + 14px) 14px 14px;
+  background: var(--wa-green-dark);
+  color: #fff;
+}
+.wa-topbar-thread { padding-left: 4px; }
+.wa-topbar-title { font-size: 19px; font-weight: 600; }
+.wa-topbar-title-block { flex: 1; min-width: 0; }
+.wa-topbar-thread .wa-topbar-title { font-size: 16px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.wa-topbar-sub { font-size: 12px; color: rgba(255,255,255,0.75); }
+
+.wa-icon-btn {
+  flex: none;
+  width: 36px;
+  height: 36px;
+  border: none;
+  background: transparent;
+  color: #fff;
+  font-size: 22px;
+  border-radius: 50%;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  cursor: pointer;
+}
+.wa-icon-btn:active { background: rgba(255,255,255,0.15); }
+#lang-settings-btn { margin-left: auto; font-size: 12px; font-weight: 700; border: 1.5px solid rgba(255,255,255,0.6); width: auto; padding: 4px 10px; border-radius: 12px; }
+
+.wa-avatar {
+  flex: none;
+  width: 36px;
+  height: 36px;
+  border-radius: 50%;
+  background: rgba(255,255,255,0.2);
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  font-weight: 600;
+  font-size: 14px;
+}
+
+/* ─── Chat list ───────────────────────────────────────────── */
+
+.wa-search {
+  flex: none;
+  padding: 8px 12px;
+  background: #fff;
+  border-bottom: 1px solid var(--wa-line);
+}
+.wa-search input {
+  width: 100%;
+  border: none;
+  background: var(--wa-line);
+  border-radius: 20px;
+  padding: 9px 14px;
+  font-size: 14.5px;
+  outline: none;
+}
+
+.wa-chat-list {
+  flex: 1;
+  overflow-y: auto;
+  background: #fff;
+  -webkit-overflow-scrolling: touch;
+}
+
+.wa-chat-row {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  padding: 12px 14px;
+  border-bottom: 1px solid var(--wa-line);
+  cursor: pointer;
+}
+.wa-chat-row:active { background: var(--wa-line); }
+.wa-chat-row .wa-avatar {
+  background: var(--accent-soft, #DBEAFE);
+  color: var(--wa-green-dark);
+  width: 46px; height: 46px; font-size: 16px;
+}
+.wa-chat-row-text { flex: 1; min-width: 0; }
+.wa-chat-row-top { display: flex; justify-content: space-between; gap: 8px; }
+.wa-chat-row-name { font-weight: 600; font-size: 15.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.wa-chat-row-time { font-size: 11.5px; color: var(--wa-text-soft); flex: none; }
+.wa-chat-row-preview { font-size: 13.5px; color: var(--wa-text-soft); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top: 2px; }
