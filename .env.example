# Single-password auth (unchanged from the Sheets version)
APP_PASSWORD=sanjay@321
SESSION_SECRET=sanjay@321
# Supabase — Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Service role key ONLY — this is used server-side by lib/supabase.js and
# bypasses Row Level Security. Never expose this in frontend code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# GoWA — self-hosted WhatsApp REST API (aldinokemal/go-whatsapp-web-multidevice)
# Base URL of your GoWA instance, no trailing slash.
GOWA_BASE_URL=https://graphicywa.onrender.com
# Only set this if your GoWA instance was started with --basic-auth=user:pass.
# Leave blank if it has no Basic Auth configured.
GOWA_BASIC_AUTH=

# Alibaba Cloud Model Studio (DashScope) — used for message translation.
# Project Settings on Model Studio -> API Key, and your Workspace ID (WID).
ALIBABA_API_KEY=your-dashscope-api-key
ALIBABA_WORKSPACE_ID=your-workspace-id
ALIBABA_REGION=ap-southeast-1
ALIBABA_MODEL=qwen-plus

# ImgBB — hosts client profile photos (https://api.imgbb.com/)
IMGBB_API_KEY=your-imgbb-api-key